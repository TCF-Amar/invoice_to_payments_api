generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── VENDOR ───────────────────────────────────────────
model Vendor {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  email     String?  @unique @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  address       String?
  bankName      String?  @map("bank_name") @db.VarChar(255)
  accountName   String?  @map("account_name") @db.VarChar(255)
  accountNumber String?  @map("account_number") @db.VarChar(100)
  routingNumber String?  @map("routing_number") @db.VarChar(50)
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at")

  // Razorpay IDs (stored after setup-vendor)
  razorpayContactId     String?  @map("razorpay_contact_id") @db.VarChar(100)
  razorpayFundAccountId String?  @map("razorpay_fund_account_id") @db.VarChar(100)

  // Stripe IDs
  stripeAccountId       String?  @map("stripe_account_id") @db.VarChar(255)

  invoices       Invoice[]
  purchaseOrders PurchaseOrder[] @relation("VendorToPO")
  vendorAliases  VendorAlias[]
  tickets        Ticket[]

  @@map("vendors")
}


// ─── PURCHASE ORDER ───────────────────────────────────
model PurchaseOrder {
  id              String    @id @default(uuid())
  poNumber        String    @unique @map("po_number") @db.VarChar(50)
  vendorId        String?   @map("vendor_id")
  vendor          Vendor?   @relation("VendorToPO", fields: [vendorId], references: [id])
  approvedAmount  Decimal   @default(0) @map("approved_total") @db.Decimal(12, 2)
  remainingAmount Decimal?  @map("remaining_invoice_amount") @db.Decimal(12, 2)
  currency        String    @default("USD") @db.VarChar(3)
  description     String?
  status          String    @default("open") @db.VarChar(30)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")
  deliveryDate    DateTime? @map("expected_delivery")

  invoices  Invoice[]
  payments  Payment[]
  auditLogs AuditLog[]
  lineItems POLineItem[]

  @@map("purchase_orders")
}

// ─── INVOICE ──────────────────────────────────────────
model Invoice {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  invoiceNumber String   @map("invoice_number") @db.VarChar(100)
  poNumber      String?  @map("po_number") @db.VarChar(50)
  vendorId      String?  @map("vendor_id")
  vendor        Vendor?  @relation(fields: [vendorId], references: [id])
  matchedPoId   String?  @map("matched_po_id")
  matchedPo     PurchaseOrder? @relation(fields: [matchedPoId], references: [id])

  // Vendor info
  vendorName    String?  @map("vendor_name") @db.VarChar(255)
  vendorEmail   String?  @map("vendor_email") @db.VarChar(255)
  vendorPhone   String?  @map("vendor_phone") @db.VarChar(50)
  vendorAddress String?  @map("vendor_address")

  // Bill to
  billToCompany String?  @map("bill_to_company") @db.VarChar(255)
  billToEmail   String?  @map("bill_to_email") @db.VarChar(255)
  billToAddress String?  @map("bill_to_address")

  // Dates
  invoiceDate   DateTime? @map("invoice_date") @db.Date
  dueDate       DateTime? @map("due_date") @db.Date
  paymentTerms  String?   @map("payment_terms") @db.VarChar(50)

  // Amounts
  currency      String    @default("USD") @db.VarChar(3)
  subtotal      Decimal?  @db.Decimal(12, 2)
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  taxRate       Decimal?  @map("tax_rate") @db.Decimal(5, 2)
  taxAmount     Decimal?  @map("tax_amount") @db.Decimal(12, 2)
  shipping      Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal?  @map("total_amount") @db.Decimal(12, 2)
  amountPaid    Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  amountDue     Decimal?  @map("amount_due") @db.Decimal(12, 2)

  // Bank details
  bankName      String?   @map("bank_name") @db.VarChar(255)
  accountName   String?   @map("account_name") @db.VarChar(255)
  accountNumber String?   @map("account_number") @db.VarChar(100)
  routingNumber String?   @map("routing_number") @db.VarChar(50)
  paymentMethod String?   @map("payment_method") @db.VarChar(50)

  // Meta
  aiConfidence  Decimal?  @map("ai_confidence") @db.Decimal(4, 3)
  rawEmailRef   String?   @map("raw_email_ref")
  notes         String?
  status        String    @default("received") @db.VarChar(30)
  flags         Json      @default("[]")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @map("updated_at")
  rejectionReason String? @map("rejection_reason")

  payments  Payment[]
  auditLogs AuditLog[]
  lineItems InvoiceLineItem[]
  tickets   Ticket[]

  @@unique([vendorId, invoiceNumber], map: "uq_invoice_vendor_number")
  @@map("invoices")
}

// ─── PAYMENT ──────────────────────────────────────────
model Payment {
  id                String      @id @default(dbgenerated("gen_random_uuid()"))
  invoiceId         String?     @map("invoice_id")
  invoice           Invoice?    @relation(fields: [invoiceId], references: [id])
  amountPaid        Decimal?    @map("amount") @db.Decimal(12, 2)
  currency          String      @default("USD") @db.VarChar(3)
  stripeId          String?     @map("stripe_payment_id") @db.VarChar(255)
  scheduledDate     DateTime?   @map("scheduled_date") @db.Date
  paidAt            DateTime?   @map("executed_at")
  status            String      @default("scheduled") @db.VarChar(30)
  failureReason     String?     @map("failure_reason")
  createdAt         DateTime    @default(now()) @map("created_at")

  poId              String?     @map("po_id")
  purchaseOrder     PurchaseOrder? @relation(fields: [poId], references: [id])

  auditLogs AuditLog[]

  @@map("payments")
}

// ─── AUDIT LOG ────────────────────────────────────────
model AuditLog {
  id              BigInt         @id @default(autoincrement())
  entityType      String?        @map("entity_type") @db.VarChar(30)
  entityId        String?        @map("entity_id")
  eventType       String?        @map("event_type") @db.VarChar(100)
  actor           String         @default("system") @db.VarChar(50)
  metadata          Json?
  invoiceId       String?        @map("invoice_id")
  paymentId       String?        @map("payment_id")
  purchaseOrderId String?        @map("purchase_order_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("audit_log")
}

// ─── LINE ITEMS ───────────────────────────────────────
model InvoiceLineItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  invoiceId        String   @map("invoice_id")
  description      String?
  qty              Decimal? @db.Decimal(12, 3)
  unitPrice        Decimal? @map("unit_price") @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model POLineItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()"))
  poId            String        @map("po_id")
  description     String
  qty             Decimal       @db.Decimal(12, 3)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@map("po_line_items")
}

model VendorAlias {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  aliasName      String   @map("alias_name") @db.VarChar(255)
  canonicalName  String   @map("canonical_name") @db.VarChar(255)
  vendorId       String?  @map("vendor_id")
  vendor         Vendor?  @relation(fields: [vendorId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("vendor_aliases")
}

// ─── TICKET ───────────────────────────────────────────
model Ticket {
  id          String   @id @default(uuid())
  subject     String   @db.VarChar(255)
  description String   @db.Text
  status      String   @default("open") @db.VarChar(30)
  priority    String   @default("medium") @db.VarChar(30)
  
  vendorId    String?  @map("vendor_id")
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  
  invoiceId   String?  @map("invoice_id")
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("tickets")
}
